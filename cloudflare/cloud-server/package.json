{
  "name": "cyrene-cloud-cf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "云端昔涟 CF 版（IKJN79）：Workers + Durable Objects(SQLite) 服务端（协议 v0 同步核心 / 配对令牌 / 生成闭环 / PWA 静态托管）。",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "assets:build": "node scripts/build-assets.mjs",
    "dev": "npm run assets:build && wrangler dev",
    "deploy": "npm run assets:build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
