<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CyreneNative</RootNamespace>
    <AssemblyName>cyrene-native</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 侧车进程：崩溃由宿主重启，不弹 WER 对话框 -->
    <DisableWinExeOutputInDebug>true</DisableWinExeOutputInDebug>
    <!-- Linux CI 上做编译验证 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF+WinForms 同工程：WinForms SDK 的全局 using（System.Drawing/
         System.Windows.Forms）会污染 WPF 文件的类型解析（Color/Button/
         Image 等 20+ 二义性）。移除全局引入，Forms 文件显式 using。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 状态/心情图标：sidebar 窗口按名加载 -->
    <Content Include="assets\status\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\feeling\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\icons\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\providers\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\loading.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 跨平台核心（cyrene-core：host 协议 / 工具 / 检索 / 记忆 / Agents / MCP） -->
    <ProjectReference Include="../cyrene-core/CyreneCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MusicLibrary 直连 SQLite（版本与 cyrene-core 统一 10.x） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- SSH 托管宿主：会话/认证（DPAPI 由 net10.0-windows 框架自带） -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- 云存储托管宿主：FTP/FTPS（SFTP 复用 SSH.NET；WebDAV 自带 HttpClient 极简实现） -->
    <PackageReference Include="FluentFTP" Version="55.0.0" />
    <!-- S3 及兼容对象存储（MinIO/R2 等：自定义 endpoint + path style） -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104" />
  </ItemGroup>
</Project>
