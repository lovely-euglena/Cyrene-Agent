<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux 冒烟壳：引用 cyrene-core（工程引用替代同源 Compile Include），
       验证跨平台核心的协议行为。Windows 实机仍以主 csproj 为准。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cyrene-smoke</AssemblyName>
    <RootNamespace>CyreneSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../cyrene-core/CyreneCore.csproj" />
  </ItemGroup>
</Project>
