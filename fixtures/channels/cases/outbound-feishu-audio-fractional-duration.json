{
  "name": "feishu 出站音频（duration 非整数原值保留）",
  "kind": "outbound",
  "channel": "feishu",
  "input": {
    "message": {
      "channel": "feishu",
      "targetId": "oc_user_1",
      "parts": [{ "kind": "audio", "filePath": "C:/tmp/voice.opus", "mime": "audio/ogg" }]
    },
    "uploads": { "C:/tmp/voice.opus": { "file_key": "file_key_1" } },
    "durations": { "C:/tmp/voice.opus": 1200.5 }
  },
  "expect": {
    "receiveIdType": "chat_id",
    "requests": [
      {
        "receive_id": "oc_user_1",
        "msg_type": "audio",
        "content": "{\"file_key\":\"file_key_1\",\"duration\":1200.5}"
      }
    ]
  }
}
