{
  "name": "feishu 出站视频（image_key 空串保留，不静默丢弃）",
  "kind": "outbound",
  "channel": "feishu",
  "input": {
    "message": {
      "channel": "feishu",
      "targetId": "oc_user_1",
      "parts": [{ "kind": "video", "filePath": "C:/tmp/clip.mp4" }]
    },
    "uploads": { "C:/tmp/clip.mp4": { "file_key": "file_key_1", "image_key": "" } }
  },
  "expect": {
    "receiveIdType": "chat_id",
    "requests": [
      {
        "receive_id": "oc_user_1",
        "msg_type": "media",
        "content": "{\"file_key\":\"file_key_1\",\"image_key\":\"\"}"
      }
    ]
  }
}
